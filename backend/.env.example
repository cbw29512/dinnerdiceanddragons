# Dinner, Dice & Dragons production API environment template
# Copy to backend/.env for local development. Never commit real secrets.

APP_ENV=local
LOG_LEVEL=INFO

# Local Docker/PostgreSQL default. Replace with the managed PostgreSQL URL in deployed environments.
DATABASE_URL=postgresql+psycopg://ddd:ddd@localhost:5432/ddd

# Added now so the configuration contract is stable before auth is implemented.
# Example: https://your-project-ref.supabase.co
SUPABASE_URL=
SUPABASE_JWT_AUDIENCE=authenticated
