# Dinner, Dice & Dragons production API environment template
# Copy to backend/.env for local development. Never commit real secrets.

APP_ENV=local
LOG_LEVEL=INFO

# Safe release metadata. Deployment automation should replace these values.
APP_VERSION=dev
BUILD_SHA=unknown

# Local Docker/PostgreSQL default. APP_ENV=production rejects localhost/loopback,
# missing managed credentials, the local ddd:ddd pair, and non-psycopg URLs.
DATABASE_URL=postgresql+psycopg://ddd:ddd@localhost:5432/ddd

# PostgreSQL connection/session bounds.
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=5000
DB_IDLE_TRANSACTION_TIMEOUT_MS=15000

# SQLAlchemy pooling for non-transaction-pooler endpoints. Supabase transaction
# pooler endpoints on port 6543 use NullPool instead.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=5
DB_POOL_RECYCLE_SECONDS=300

# Shared bound for outbound Supabase JWKS and Geocodio HTTP requests.
OUTBOUND_HTTP_TIMEOUT_SECONDS=5

# Supabase project base URL. The API derives the Auth issuer as <SUPABASE_URL>/auth/v1
# and the asymmetric signing keys from <issuer>/.well-known/jwks.json.
# Local Supabase: http://127.0.0.1:54321
# Hosted example: https://your-project-ref.supabase.co
SUPABASE_URL=
SUPABASE_JWT_AUDIENCE=authenticated

# Server-side geocoding credential used to resolve verified public Venue addresses
# and ZIP centroids. APP_ENV=production requires a nonblank value.
# Never expose this key to browser code or commit a real value.
GEOCODIO_API_KEY=

# Comma-separated browser origins allowed to call the API with bearer tokens.
# Origins are scheme + host + optional port only: no paths, queries, or fragments.
# APP_ENV=production requires at least one non-loopback HTTPS origin and rejects '*'.
# Production should use the final Netlify/custom-domain HTTPS origin.
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Optional locally. Managed hosts inject PORT at runtime.
PORT=8000
